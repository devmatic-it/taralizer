Thumbs.db

# Report outputs (generated)
report.*
examples/gcp/report.html
examples/gcp/report.pdf
examples/gcp/report_graphviz.pdf
taralizer.rb
# Vendor (if used)
vendor/

# Local config & agent/IDE state
config.yaml
.pi-lens/
.opencode/
.pi/

# Working documents (optional - remove if obsolete)
tasks/
examples/gcp/terraform/taralizer.yaml
